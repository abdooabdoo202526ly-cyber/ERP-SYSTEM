{
  "name": "PayrollRun",
  "table": "payroll_runs",
  "version": "1.0.0",
  "module": "Payroll",
  "fields": [
    { "name": "id", "type": "uuid", "nullable": false, "primary_key": true },
    { "name": "tenant_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "tenants", "column": "id", "on_delete": "cascade" } },
    { "name": "period_start", "type": "timestamptz", "nullable": false },
    { "name": "period_end", "type": "timestamptz", "nullable": false },
    { "name": "status", "type": "varchar(20)", "nullable": false, "default": "'Draft'" },
    { "name": "total_gross", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "total_net", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "processed_at", "type": "timestamptz", "nullable": true },
    { "name": "posted_at", "type": "timestamptz", "nullable": true },
    { "name": "notes", "type": "text", "nullable": true },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()" },
    { "name": "created_by", "type": "uuid", "nullable": false },
    { "name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()" },
    { "name": "updated_by", "type": "uuid", "nullable": true }
  ],
  "indexes": [
    { "name": "ix_payroll_runs_tenant_status", "columns": ["tenant_id", "status"] },
    { "name": "ix_payroll_runs_tenant_period", "columns": ["tenant_id", "period_start"] },
    { "name": "ix_payroll_runs_tenant_created", "columns": ["tenant_id", "created_at"] }
  ]
}