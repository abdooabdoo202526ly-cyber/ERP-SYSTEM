{
  "name": "PasswordResetToken",
  "table": "password_reset_tokens",
  "version": "1.0.0",
  "module": "Identity",
  "fields": [
    { "name": "id", "type": "uuid", "nullable": false, "primary_key": true },
    { "name": "tenant_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "tenants", "column": "id", "on_delete": "cascade" } },
    { "name": "user_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "users", "column": "id", "on_delete": "cascade" } },
    { "name": "token_hash", "type": "varchar(255)", "nullable": false },
    { "name": "expires_at", "type": "timestamptz", "nullable": false },
    { "name": "used_at", "type": "timestamptz", "nullable": true },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()" }
  ],
  "indexes": [
    { "name": "ix_password_reset_token_hash", "columns": ["token_hash"], "unique": true },
    { "name": "ix_password_reset_user", "columns": ["user_id"] }
  ]
}
