{
  "name": "AuditLog",
  "table": "audit_log",
  "version": "1.0.0",
  "module": "Shared",
  "fields": [
    { "name": "id", "type": "bigserial", "nullable": false, "primary_key": true },
    { "name": "tenant_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "tenants", "column": "id", "on_delete": "cascade" } },
    { "name": "entity_type", "type": "varchar(50)", "nullable": false },
    { "name": "entity_id", "type": "uuid", "nullable": false },
    { "name": "action", "type": "varchar(20)", "nullable": false },
    { "name": "user_id", "type": "uuid", "nullable": true },
    { "name": "changes", "type": "jsonb", "nullable": true },
    { "name": "ip_address", "type": "varchar(45)", "nullable": true },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()" }
  ],
  "indexes": [
    { "name": "ix_audit_log_entity", "columns": ["tenant_id", "entity_type", "entity_id", "created_at"] },
    { "name": "ix_audit_log_user", "columns": ["tenant_id", "user_id", "created_at"] }
  ]
}