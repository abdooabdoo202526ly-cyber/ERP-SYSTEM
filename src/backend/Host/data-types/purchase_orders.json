{
  "name": "PurchaseOrder",
  "table": "purchase_orders",
  "version": "1.0.0",
  "module": "Procurement",
  "fields": [
    { "name": "id", "type": "uuid", "nullable": false, "primary_key": true },
    { "name": "tenant_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "tenants", "column": "id", "on_delete": "cascade" } },
    { "name": "po_number", "type": "varchar(50)", "nullable": false },
    { "name": "vendor_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "vendors", "column": "id", "on_delete": "restrict" } },
    { "name": "project_id", "type": "uuid", "nullable": true,
      "foreign_key": { "table": "projects", "column": "id", "on_delete": "set null" } },
    { "name": "cost_center_id", "type": "uuid", "nullable": true,
      "foreign_key": { "table": "cost_centers", "column": "id", "on_delete": "set null" } },
    { "name": "status", "type": "varchar(20)", "nullable": false, "default": "'Draft'" },
    { "name": "order_date", "type": "timestamptz", "nullable": false },
    { "name": "expected_date", "type": "timestamptz", "nullable": true },
    { "name": "currency", "type": "varchar(3)", "nullable": false, "default": "'LYD'" },
    { "name": "sub_total", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "tax_amount", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "total_amount", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "notes", "type": "text", "nullable": true },
    { "name": "approved_at", "type": "timestamptz", "nullable": true },
    { "name": "approved_by", "type": "uuid", "nullable": true },
    { "name": "sent_at", "type": "timestamptz", "nullable": true },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()" },
    { "name": "created_by", "type": "uuid", "nullable": false },
    { "name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()" },
    { "name": "updated_by", "type": "uuid", "nullable": true }
  ],
  "indexes": [
    { "name": "ix_purchase_orders_tenant_ponumber", "columns": ["tenant_id", "po_number"], "unique": true },
    { "name": "ix_purchase_orders_tenant_vendor", "columns": ["tenant_id", "vendor_id"] },
    { "name": "ix_purchase_orders_tenant_status", "columns": ["tenant_id", "status"] }
  ]
}
