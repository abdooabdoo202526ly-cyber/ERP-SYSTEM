{
  "name": "Item",
  "table": "items",
  "version": "1.0.0",
  "module": "Inventory",
  "fields": [
    { "name": "id", "type": "uuid", "nullable": false, "primary_key": true },
    { "name": "tenant_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "tenants", "column": "id", "on_delete": "cascade" } },
    { "name": "company_id", "type": "uuid", "nullable": false,
      "foreign_key": { "table": "companies", "column": "id", "on_delete": "restrict" } },
    { "name": "sku", "type": "varchar(50)", "nullable": false },
    { "name": "barcode", "type": "varchar(100)", "nullable": true },
    { "name": "name", "type": "varchar(200)", "nullable": false },
    { "name": "description", "type": "text", "nullable": true },
    { "name": "category_id", "type": "uuid", "nullable": true,
      "foreign_key": { "table": "item_categories", "column": "id", "on_delete": "set_null" } },
    { "name": "unit_of_measure_id", "type": "uuid", "nullable": true,
      "foreign_key": { "table": "units_of_measure", "column": "id", "on_delete": "set_null" } },
    { "name": "item_type", "type": "integer", "nullable": false, "default": "1" },
    { "name": "costing_method", "type": "integer", "nullable": false, "default": "3" },
    { "name": "average_cost", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "standard_cost", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "inventory_account_id", "type": "uuid", "nullable": true,
      "foreign_key": { "table": "accounts", "column": "id", "on_delete": "set_null" } },
    { "name": "cogs_account_id", "type": "uuid", "nullable": true,
      "foreign_key": { "table": "accounts", "column": "id", "on_delete": "set_null" } },
    { "name": "sales_account_id", "type": "uuid", "nullable": true,
      "foreign_key": { "table": "accounts", "column": "id", "on_delete": "set_null" } },
    { "name": "reorder_level", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "reorder_quantity", "type": "numeric(18,4)", "nullable": false, "default": "0" },
    { "name": "is_active", "type": "boolean", "nullable": false, "default": "true" },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()" },
    { "name": "created_by", "type": "uuid", "nullable": false },
    { "name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()" },
    { "name": "updated_by", "type": "uuid", "nullable": true }
  ],
  "indexes": [
    { "name": "ix_items_tenant_sku", "columns": ["tenant_id", "sku"], "unique": true },
    { "name": "ix_items_tenant_company_active", "columns": ["tenant_id", "company_id", "is_active"] },
    { "name": "ix_items_category", "columns": ["category_id"] },
    { "name": "ix_items_barcode", "columns": ["barcode"] }
  ]
}